{
  "name": "@falcon-grid/text",
  "version": "0.0.0",
  "description": "Text wrapping for falcon-grid, built on Pretext.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0"
  },
  "peerDependencies": {
    "@falcon-grid/core": "workspace:*"
  },
  "devDependencies": {
    "@falcon-grid/core": "workspace:*"
  }
}
