{
  "name": "falcon-grid-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./tools/**\" run build",
    "typecheck": "pnpm -r run typecheck && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "pnpm build && size-limit",
    "dev": "pnpm --filter @falcon-grid/playground dev",
    "bench": "pnpm --filter @falcon-grid/bench run bench",
    "check": "pnpm typecheck && pnpm test && pnpm size",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@falcon-grid/cells": "workspace:*",
    "@falcon-grid/core": "workspace:*",
    "@falcon-grid/datagen": "workspace:*",
    "@falcon-grid/react": "workspace:*",
    "@falcon-grid/tanstack": "workspace:*",
    "@falcon-grid/text": "workspace:*",
    "@playwright/test": "1.49.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/table-core": "8.21.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "fast-check": "^4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
